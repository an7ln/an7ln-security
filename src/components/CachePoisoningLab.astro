<cache-poisoning-lab class="cache-lab" data-pagefind-ignore>
  <header><span>交互实验 / 01</span><h3>谁写入，谁命中？</h3><p>同一个 /news，两位访问者。先发送测试请求，再让普通读者访问。</p></header>
  <div class="controls">
    <label>测试请求的 X-Forwarded-Host<select data-host><option value="notice.example">notice.example · 非预期来源</option><option value="blog.example">blog.example · 正常来源</option></select></label>
    <label>防护策略<select data-policy><option value="vulnerable">存在缺陷：信任头部，但不加入缓存键</option><option value="keyed">隔离变体：把该头部加入缓存键</option><option value="fixed">修正源站：使用固定资源来源</option><option value="no-store">不存储：源站响应 no-store</option></select></label>
  </div>
  <p class="policy-note" data-policy-note>源站根据请求头生成资源地址，缓存却只区分方法、站点和路径。</p>
  <div class="flow" aria-label="请求处理流程"><span data-node="request">01 请求到达</span><b>→</b><span data-node="cache">02 共享缓存</span><b>→</b><span data-node="origin">03 源站生成</span></div>
  <div class="actions"><button data-action="tester">① 发送测试请求</button><button data-action="reader">② 普通读者访问</button><button data-action="expire">时间推进 61 秒</button><button data-action="reset">清空并重置</button></div>
  <div class="result" aria-live="polite" aria-atomic="true"><strong data-status>等待请求</strong><p data-message>缓存为空。也可以先让普通读者访问，看看预热缓存如何改变结果。</p></div>
  <div class="panels"><section><h4>本次请求与缓存键</h4><pre data-request>尚未发送请求</pre></section><section><h4>返回给访问者的内容</h4><pre data-response>尚无响应</pre></section></div>
  <section class="store"><h4>缓存快照 <span data-clock>模拟时间 0 秒</span></h4><div data-store>空缓存</div></section>
  <details><summary>查看本轮请求记录</summary><ol data-log></ol></details>
  <p class="footnote">简化模型：固定 GET、HTTPS、站点与路径；TTL 为 60 秒，无重验证或多层缓存。资源地址仅以文本显示，按钮不会发起网络请求。切换策略会开始新一轮并清空模拟缓存。</p>
</cache-poisoning-lab>

<script>
  class CachePoisoningLab extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const pick = <T extends HTMLElement>(s: string) => this.querySelector<T>(s)!;
      const host = pick<HTMLSelectElement>('[data-host]');
      const policy = pick<HTMLSelectElement>('[data-policy]');
      const entries = new Map<string, { source: string; stored: number }>();
      let now = 0;
      const write = (selector: string, value: string) => { pick(selector).textContent = value; };
      const snapshot = () => {
        write('[data-clock]', `模拟时间 ${now} 秒`);
        const container = pick('[data-store]'); container.replaceChildren();
        for (const [key, item] of entries) {
          const row = document.createElement('p');
          row.textContent = `${key}\n资源来源：${item.source} · 剩余 ${60 - (now - item.stored)} 秒`;
          container.append(row);
        }
        if (!entries.size) container.textContent = '空缓存';
      };
      const reset = () => {
        entries.clear(); now = 0; snapshot();
        write('[data-status]', '等待请求'); write('[data-message]', '新一轮实验已开始，缓存为空。');
        write('[data-request]', '尚未发送请求'); write('[data-response]', '尚无响应');
        pick('[data-log]').replaceChildren(); this.dataset.outcome = '';
        this.querySelectorAll('[data-node]').forEach(e => e.removeAttribute('data-active'));
      };
      policy.addEventListener('change', () => {
        reset();
        const notes: Record<string, string> = {
          vulnerable: '源站根据请求头生成资源地址，缓存却只区分方法、站点和路径。',
          keyed: '测试者与无该头部的读者使用不同缓存键。恶意变体仍然存在；这是隔离，不是修正源站信任。',
          fixed: '源站忽略外部提供的资源域名，统一生成 blog.example 地址。',
          'no-store': '响应不进入缓存；单次请求仍可能产生非预期地址，但不会通过本模型的缓存传播。',
        };
        write('[data-policy-note]', notes[policy.value]);
      });
      this.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(button => button.addEventListener('click', () => {
        const action = button.dataset.action;
        if (action === 'reset') { reset(); return; }
        if (action === 'expire') {
          now += 61; entries.clear(); snapshot();
          write('[data-status]', '缓存已过期'); write('[data-message]', '时间推进 61 秒，旧条目被移除。上方请求与响应保留作比较；下一次请求将重新访问源站。');
          this.dataset.outcome = ''; return;
        }
        const tester = action === 'tester';
        const supplied = tester ? host.value : '';
        const key = 'GET | https://blog.example/news' + (policy.value === 'keyed' ? ` | XFH=${supplied || '∅'}` : '');
        const cached = entries.get(key);
        const hit = Boolean(cached);
        const source = cached?.source ?? (policy.value === 'fixed' ? 'blog.example' : supplied || 'blog.example');
        const store = policy.value !== 'no-store';
        if (!cached && store) entries.set(key, { source, stored: now });
        const poisoned = source !== 'blog.example';
        this.dataset.outcome = poisoned ? 'altered' : 'normal';
        write('[data-status]', `${tester ? '测试者' : '普通读者'} · ${hit ? 'HIT 命中缓存' : 'MISS 访问源站'}`);
        write('[data-message]', !tester && poisoned ? '读者没有发送特殊头部，却收到了另一位访问者写入的非预期资源地址：跨访问者污染已发生。' : hit ? '本次没有访问源站。收到的是已有缓存内容，请求头不会重新参与页面生成。' : poisoned ? '源站生成了非预期资源地址。' + (store ? '响应已写入共享缓存，继续让普通读者访问。' : '响应未存储，不会留下共享条目。') : '返回正常资源地址。' + (store ? '响应可供后续相同缓存键的请求复用。' : '响应未存储。'));
        write('[data-request]', `GET /news HTTP/1.1\nHost: blog.example\n${supplied ? `X-Forwarded-Host: ${supplied}\n` : '(未携带 X-Forwarded-Host)\n'}\n缓存键：\n${key}`);
        write('[data-response]', `HTTP/1.1 200 OK\nCache-Control: ${store ? 'public, max-age=60' : 'no-store'}\n${hit ? `Age: ${now - cached!.stored}\n` : ''}\n页面中的资源地址：\nhttps://${source}/assets/site.js\n\n（仅展示字符串，不加载此资源）`);
        this.querySelectorAll<HTMLElement>('[data-node]').forEach(e => e.toggleAttribute('data-active', e.dataset.node !== 'origin' || !hit));
        const li = document.createElement('li'); li.textContent = `${now}s · ${tester ? '测试者' : '普通读者'} · ${hit ? 'HIT' : 'MISS'} · ${source}`;
        pick('[data-log]').prepend(li);
        if (pick('[data-log]').children.length > 12) pick('[data-log]').lastElementChild?.remove();
        snapshot();
      }));
    }
  }
  if (!customElements.get('cache-poisoning-lab')) customElements.define('cache-poisoning-lab', CachePoisoningLab);
</script>

<style>
  .cache-lab { display:block; margin:2rem 0; padding:clamp(1rem,3vw,1.75rem); border:1px solid var(--rule-strong); background:var(--ink-deep); color:var(--paper); font: .9rem/1.7 var(--sans); overflow-wrap:anywhere; }
  header > span,.footnote { color:var(--steel-bright); font-size:.75rem; }
  header > span { color:var(--amber); font-family:var(--mono); }
  h3 { font-size:1.6rem; margin:.5rem 0; } h4 { font-size:.85rem; margin:0 0 .8rem; color:var(--paper); }
  p { margin:.6rem 0; } .controls,.panels { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.25rem 0; }
  label { display:grid;gap:.5rem;color:var(--steel-bright); } select { width:100%;min-width:0;background:var(--ink-soft);color:var(--paper);border:1px solid var(--rule-strong);padding:.75rem;font:inherit; }
  .flow { display:flex;align-items:center;gap:.6rem;margin:1.5rem 0; } .flow span { flex:1;padding:.75rem;border:1px solid var(--rule);text-align:center; } .flow b { color:var(--amber); } [data-active] { border-color:var(--amber)!important;background:var(--ink-soft); }
  .actions { display:flex;gap:.65rem;flex-wrap:wrap; } button { padding:.65rem .85rem;min-height:44px;border:1px solid var(--rule-strong);background:transparent;color:var(--paper);font:inherit;cursor:pointer; } button:first-child { border-color:var(--amber);color:var(--amber); } button:hover { background:var(--ink-soft); } :is(button,select,summary):focus-visible { outline:2px solid var(--amber);outline-offset:3px; }
  .result { margin-top:1.25rem;padding:1rem;border-left:3px solid var(--amber);background:var(--ink-soft); } [data-outcome=altered] .result { border-color:#ec8484; } [data-outcome=normal] .result { border-color:#88c7ac; }
  .panels section { min-width:0; } pre { margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font:.75rem/1.8 var(--mono);padding:.8rem;background:var(--ink-soft);border:1px solid var(--rule); }
  .store { border-block:1px solid var(--rule);padding:1rem 0; } .store h4 span { display:block;font-weight:400;color:var(--steel-bright); } [data-store] { font:.75rem/1.8 var(--mono);white-space:pre-wrap; } details { margin:1rem 0; } summary { cursor:pointer; } ol { padding-left:1.3rem; } .policy-note { min-height:3.4em;color:var(--steel-bright); }
  @media(max-width:650px) { .controls,.panels { grid-template-columns:1fr; } .flow { gap:.3rem;font-size:.75rem; } .flow span { padding:.6rem .25rem; } .actions button { flex:1 1 40%; } }
</style>
