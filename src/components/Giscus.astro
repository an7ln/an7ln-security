---
const repo = import.meta.env.PUBLIC_GISCUS_REPO ?? 'an7ln/an7ln-security';
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID ?? 'R_kgDOUKP_iw';
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY ?? 'Announcements';
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID ?? 'DIC_kwDOUKP_i84DEnE6';
const enabled = Boolean(repo && repoId && categoryId);
---
{enabled && (
  <section class="discussion" aria-labelledby="discussion-title">
    <div><span class="section-number">// 讨论</span><h2 id="discussion-title">继续分析与交流</h2></div>
    <script is:inline define:vars={{ repo, repoId, category, categoryId }}>
      (() => {
        const section = document.currentScript.parentElement;
        const theme = () => document.documentElement.dataset.theme === 'dark' ? 'dark_dimmed' : 'light';
        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        Object.assign(script.dataset, { repo, repoId, category, categoryId, mapping: 'pathname', strict: '1', reactionsEnabled: '1', emitMetadata: '0', inputPosition: 'top', theme: theme(), lang: 'zh-CN' });
        script.crossOrigin = 'anonymous';
        script.async = true;
        const syncTheme = () => {
          script.dataset.theme = theme();
          section.querySelector('iframe.giscus-frame')?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
        };
        document.addEventListener('site-theme-change', syncTheme);
        section.addEventListener('load', event => { if (event.target instanceof HTMLIFrameElement) syncTheme(); }, true);
        section.append(script);
      })();
    </script>
  </section>
)}
<style>
  .discussion { margin-top: 5rem; padding-top: 2rem; border-top: 1px solid var(--rule); }
  .discussion h2 { margin: .6rem 0 2rem; font-family: var(--display); font-size: 2.5rem; line-height: 1; text-transform: uppercase; }
</style>
