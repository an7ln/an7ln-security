---
import { latestContentDate, formatDate } from '../lib/content-dates';
interface Props {
  index?: string;
  label?: string;
  updated?: Date;
}
const { index = '001', label = '公开', updated } = Astro.props;
const date = updated ?? await latestContentDate();
---
<aside class="archive-rail" aria-label="档案信息">
  <strong>AN7LN<br />公开档案</strong>
  <dl>
    <div><dt>编号</dt><dd>{index}</dd></div>
    <div><dt>类型</dt><dd>{label}</dd></div>
    <div><dt>范围</dt><dd>公开</dd></div>
    {date && <div><dt>{updated ? '文章更新' : '内容更新'}</dt><dd><time datetime={formatDate(date)}>{formatDate(date).replaceAll('-', '.')}</time></dd></div>}
    <div><dt>披露</dt><dd>负责任<br />披露</dd></div>
  </dl>
</aside>
