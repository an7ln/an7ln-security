<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-topline">
    <span id="search-title" class="mono-label">检索公开档案</span>
    <button type="button" data-close-search aria-label="关闭搜索">Esc</button>
  </div>
  <label class="search-field">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.5" />
      <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.5" />
    </svg>
    <span class="sr-only">搜索关键词</span>
    <input data-search-input type="search" autocomplete="off" placeholder="搜索研究、笔记、工具…" />
  </label>
  <div class="search-status" data-search-status>输入关键词，检索公开档案。</div>
  <ol class="search-results" data-search-results></ol>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.querySelector('[data-search-dialog]');
    const input = dialog?.querySelector('[data-search-input]');
    const results = dialog?.querySelector('[data-search-results]');
    const status = dialog?.querySelector('[data-search-status]');
    let fallback = [];
    let pagefind;

    const open = () => {
      if (!dialog?.open) dialog?.showModal();
      requestAnimationFrame(() => input?.focus());
    };
    const close = () => dialog?.close();
    document.querySelectorAll('[data-open-search]').forEach((button) => button.addEventListener('click', open));
    dialog?.querySelector('[data-close-search]')?.addEventListener('click', close);
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); open(); }
    });

    fetch('/search-index.json').then((response) => response.json()).then((items) => { fallback = items; }).catch(() => {});

    const loadPagefind = async () => {
      if (pagefind !== undefined) return pagefind;
      try {
        pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        await pagefind.init();
      } catch { pagefind = null; }
      return pagefind;
    };

    const render = (items) => {
      results.replaceChildren();
      items.slice(0, 7).forEach((item) => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        const meta = document.createElement('span');
        const title = document.createElement('strong');
        const excerpt = document.createElement('small');
        link.href = item.url;
        meta.textContent = item.type ?? '档案';
        title.textContent = item.title;
        excerpt.textContent = item.excerpt ?? '';
        link.append(meta, title, excerpt);
        li.append(link);
        results.append(li);
      });
      status.textContent = items.length ? `找到 ${items.length} 条结果` : '没有匹配的公开记录。';
    };

    let timer;
    input?.addEventListener('input', () => {
      clearTimeout(timer);
      const query = input.value.trim();
      if (!query) { results.replaceChildren(); status.textContent = '输入关键词，检索公开档案。'; return; }
      status.textContent = '正在检索…';
      timer = setTimeout(async () => {
        const pf = await loadPagefind();
        if (pf) {
          const response = await pf.search(query);
          const data = await Promise.all(response.results.slice(0, 7).map((result) => result.data()));
          render(data.map((item) => ({ url: item.url, title: item.meta.title, excerpt: item.excerpt.replace(/<[^>]*>/g, ''), type: item.meta.type })));
          return;
        }
        const lowered = query.toLowerCase();
        render(fallback.filter((item) => `${item.title} ${item.excerpt} ${item.type}`.toLowerCase().includes(lowered)));
      }, 180);
    });
  })();
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  .search-dialog {
    width: min(48rem, calc(100% - 2rem));
    max-height: min(44rem, calc(100vh - 2rem));
    margin: 8vh auto 0;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 2rem 6rem rgba(0,0,0,.55);
  }
  .search-dialog::backdrop { background: rgba(2, 6, 10, .78); backdrop-filter: blur(6px); }
  .search-topline { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border-bottom: 1px solid var(--rule); }
  .search-topline button { border: 1px solid var(--rule); background: transparent; color: var(--steel-bright); font: .65rem/1 var(--mono); text-transform: uppercase; }
  .search-field { display: flex; align-items: center; gap: 1rem; padding: 1.25rem; border-bottom: 1px solid var(--rule); color: var(--amber); }
  .search-field input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--paper); font-size: 1.25rem; }
  .search-field input::placeholder { color: var(--steel); }
  .search-status { padding: .8rem 1.25rem; border-bottom: 1px solid var(--rule); color: var(--steel); font: .68rem/1 var(--mono); text-transform: uppercase; }
  .search-results { overflow: auto; max-height: 29rem; margin: 0; padding: 0; list-style: none; }
  .search-results li { border-bottom: 1px solid var(--rule); }
  .search-results a { display: grid; gap: .3rem; padding: 1rem 1.25rem; }
  .search-results a:hover { background: rgba(242,239,231,.05); }
  .search-results span { color: var(--amber); font: .65rem/1 var(--mono); text-transform: uppercase; }
  .search-results strong { font-size: 1rem; }
  .search-results small { overflow: hidden; color: var(--steel-bright); font-size: .8rem; text-overflow: ellipsis; white-space: nowrap; }
</style>
