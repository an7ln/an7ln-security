---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; }
const headings = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---
{headings.length > 0 && (
  <aside class="article-toc" data-pagefind-ignore>
    <nav class="toc-desktop" aria-label="文章目录">
      <h2 class="toc-title">本文目录</h2>
      <ol>{headings.map(heading => <li class:list={{ 'toc-nested': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
    </nav>
    <details class="toc-mobile">
      <summary>本文目录 <span>{headings.length} 个章节</span></summary>
      <nav aria-label="文章目录"><ol>{headings.map(heading => <li class:list={{ 'toc-nested': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
    </details>
  </aside>
)}
<style>
  .article-toc { min-width: 0; grid-column: 2; grid-row: 1; align-self: start; position: sticky; top: 2rem; }
  .toc-desktop { border-left: 1px solid var(--rule); padding-left: 1.25rem; max-height: calc(100dvh - 4rem); overflow-y: auto; }
  .toc-title { margin: 0 0 1rem; color: var(--amber); font: 600 .8rem/1.5 var(--mono); }
  ol { margin: 0; padding: 0; list-style: none; }
  a { display: block; padding: .45rem .15rem; color: var(--steel-bright); font-size: .82rem; line-height: 1.65; overflow-wrap: anywhere; }
  a:hover, a:focus-visible { color: var(--amber); }
  .toc-nested { padding-left: .9rem; }
  .toc-nested a { font-size: .76rem; }
  .toc-mobile { display: none; }
  @media (max-width: 1100px) {
    .article-toc { grid-column: 1; position: static; }
    .toc-desktop { display: none; }
    .toc-mobile { display: block; border-block: 1px solid var(--rule); }
    summary { padding: .9rem 0; cursor: pointer; color: var(--amber); font-size: .9rem; }
    summary span { margin-left: .75rem; color: var(--steel-bright); font-size: .75rem; }
    .toc-mobile nav { padding-bottom: 1rem; }
    a { padding-block: .7rem; font-size: .9rem; }
  }
</style>
